  "claims": [
    {
      "id": "e-dimensions",
      "theoryId": "russell-descriptive",
      "text": "Приятность и возбуждение описывают разные стороны аффективного состояния.",
      "status": "accepted-within-theory",
      "sourceIds": ["e-lecture", "e-russell"],
      "scope": "Описание введённых пользователем характеристик.",
      "limitation": "Положение на плоскости не определяет, почему это страх, гнев или другое переживание.",
      "predicate": "describes-along-dimensions",
      "roles": [
        {
          "role": "description",
          "conceptId": "e-affect"
        },
        {
          "role": "pleasantness",
          "conceptId": "e-valence"
        },
        {
          "role": "activation",
          "conceptId": "e-arousal"
        }
      ]
    },
    {
      "id": "e-no-category",
      "theoryId": "russell-descriptive",
      "text": "По двум заданным координатам этот пилот не присваивает название эмоции.",
      "status": "didactic",
      "sourceIds": ["e-lecture", "e-design"],
      "scope": "Граница модели-пилота.",
      "limitation": "Не воспроизводится весь circumplex или все утверждения автора о структуре аффекта.",
      "predicate": "limits-inference",
      "roles": [
        {
          "role": "description",
          "conceptId": "e-affect"
        },
        {
          "role": "pleasantness",
          "conceptId": "e-valence"
        },
        {
          "role": "activation",
          "conceptId": "e-arousal"
        }
      ]
    },
    {
      "id": "e-ordinal",
      "theoryId": "russell-descriptive",
      "text": "Положение маркера — схема категорий самоописания, не измеренная величина и не расстояние между эмоциями.",
      "status": "didactic",
      "sourceIds": ["e-design"],
      "scope": "Три видимых уровня каждой оси.",
      "limitation": "Шаги сетки не калиброваны и не являются психометрической шкалой.",
      "predicate": "display-convention",
      "roles": [
        {
          "role": "description",
          "conceptId": "e-affect"
        },
        {
          "role": "pleasantness",
          "conceptId": "e-valence"
        },
        {
          "role": "activation",
          "conceptId": "e-arousal"
        }
      ]
    },
    {
      "id": "e-appraisal",
      "theoryId": "appraisal-qualitative",
      "text": "Один факт получает разное значение относительно целей, ожиданий и возможности влияния.",
      "status": "accepted-within-theory",
      "sourceIds": ["e-lecture", "e-scherer"],
      "scope": "Качественная оценочная перспектива, слайды 22–24.",
      "limitation": "Это не полный CPM: последовательность всех проверок, синхронизация тела и временная динамика не реализованы.",
      "predicate": "appraises",
      "roles": [
        {
          "role": "episode",
          "conceptId": "e-episode"
        },
        {
          "role": "appraisal",
          "conceptId": "e-goals"
        },
        {
          "role": "response",
          "conceptId": "e-action"
        }
      ]
    },
    {
      "id": "e-affordance",
      "theoryId": "appraisal-qualitative",
      "text": "Для помехи цели возможность влияния меняет учебные варианты: изменение условий или поддержка и адаптация. Если задержка помогает цели, рассматривается использование дополнительного времени.",
      "status": "didactic",
      "sourceIds": ["e-lecture", "e-design"],
      "sourceSpan": {
        "sourceId": "e-design",
        "locator": "docs/model-lab/DESIGN.md, раздел Pilot 2: emotions, предложение 3",
        "basis": "project-design",
        "status": "didactic"
      },
      "scope": "Учебный набор вариантов ответа в сценарии задержки.",
      "limitation": "Набор не предсказывает реальное действие, эмоцию, эффективность стратегии или единственно правильный выбор.",
      "predicate": "illustrative-affordance-rule",
      "roles": [
        {
          "role": "episode",
          "conceptId": "e-episode"
        },
        {
          "role": "appraisal",
          "conceptId": "e-goals"
        },
        {
          "role": "response",
          "conceptId": "e-action"
        }
      ]
    },
    {
      "id": "e-unknown",
      "theoryId": "comparison-didactic",
      "text": "Неуказанные переменные остаются «не представлено»; неизвестное возбуждение не равно низкому, неизвестная валентность — нейтральной.",
      "status": "didactic",
      "sourceIds": ["e-design"],
      "scope": "Правило представления пропущенных данных.",
      "limitation": "Программа не восстанавливает отсутствующий самоотчёт по обстоятельствам.",
      "predicate": "unknown-is-not-zero",
      "roles": [
        {
          "role": "dimensions",
          "conceptId": "e-affect"
        },
        {
          "role": "appraisal",
          "conceptId": "e-episode"
        }
      ]
    },
    {
      "id": "e-isolation",
      "theoryId": "comparison-didactic",
      "text": "Условия оценки и самоописание аффекта поступают в разные модели; изменение контроля не перемещает маркер без нового самоописания.",
      "status": "didactic",
      "sourceIds": ["e-design", "e-lecture"],
      "scope": "Протокол сравнения данного пилота.",
      "limitation": "Это ограничение адаптеров, а не утверждение, что контроль никогда не влияет на реальное переживание.",
      "predicate": "separates-inputs",
      "roles": [
        {
          "role": "dimensions",
          "conceptId": "e-affect"
        },
        {
          "role": "appraisal",
          "conceptId": "e-episode"
        }
      ]
    },
    {
      "id": "e-scenario-claim",
      "theoryId": "comparison-didactic",
      "text": "Общий факт: результат работы задерживается, срок неизвестен. Участник по-разному оценивает последствия для своей цели.",
      "status": "didactic",
      "sourceIds": ["e-lecture"],
      "scope": "Учебный сценарий слайда 24.",
      "limitation": "Сценарий не является эмпирическим наблюдением или экспериментом над человеком.",
