        {
          "role": "stimulus",
          "conceptId": "b-stimulus"
        },
        {
          "role": "response",
          "conceptId": "b-response"
        },
        {
          "role": "unit",
          "conceptId": "b-transaction"
        }
      ]
    },
    {
      "id": "b-crossed",
      "theoryId": "berne-structural",
      "text": "Если источник или адресат ответа не совпадает с ожидаемым обратным вектором, трансакция классифицируется как пересекающаяся.",
      "status": "accepted-within-theory",
      "sourceIds": [
        "b-atlas",
        "b-overview"
      ],
      "scope": "Один явно заданный уровень.",
      "limitation": "Пересечение нарисованных линий само по себе не определяет класс.",
      "predicate": "mismatch",
      "roles": [
        {
          "role": "stimulus",
          "conceptId": "b-stimulus"
        },
        {
          "role": "response",
          "conceptId": "b-response"
        },
        {
          "role": "unit",
          "conceptId": "b-transaction"
        }
      ]
    },
    {
      "id": "b-hidden",
      "theoryId": "berne-structural",
      "text": "Скрытая трансакция рассматривает социальное и психологическое сообщения одновременно.",
      "status": "accepted-within-theory",
      "sourceIds": [
        "b-atlas",
        "b-overview"
      ],
      "scope": "Два явно различаемых уровня.",
      "limitation": "Программа не обнаруживает скрытый мотив: наличие второго уровня задаётся как учебная гипотеза.",
