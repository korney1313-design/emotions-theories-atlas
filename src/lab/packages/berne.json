  "claims": [
    {
      "id": "b-reversal",
      "theoryId": "berne-structural",
      "text": "Дополнительный ответ возвращается из адресованного эго-состояния к исходному состоянию отправителя.",
      "status": "accepted-within-theory",
      "sourceIds": [
        "b-atlas",
        "b-overview"
      ],
      "scope": "Пара заданных векторов одного уровня.",
      "limitation": "Формальная классификация не устанавливает эго-состояния реальных людей.",
      "predicate": "complementary-iff-reversed-endpoints",
