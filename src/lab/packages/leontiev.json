  "concepts": [
    {
      "id": "lc-theory",
      "term": "Теория деятельности",
      "theoryId": "leontiev-theory",
      "definition": "Предметная деятельность рассматривается как категория психологического анализа.",
      "sourceIds": [
        "l-design"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "theory"
      }
    },
    {
      "id": "lc-object",
      "term": "Предметность",
      "theoryId": "leontiev-theory",
      "definition": "Деятельность направлена на предмет, который имеет значение для субъекта.",
      "sourceIds": [
        "l-design"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "object"
      }
    },
    {
      "id": "lc-reflection",
      "term": "Психическое отражение",
      "theoryId": "leontiev-theory",
      "definition": "Отражение включено в предметные отношения, а не представлено изолированной реакцией.",
      "sourceIds": [
        "l-design"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "reflection"
      }
    },
    {
      "id": "lc-mediation",
      "term": "Общественное опосредствование",
      "theoryId": "leontiev-theory",
      "definition": "Человеческая деятельность и сознание формируются в общественных отношениях.",
      "sourceIds": [
        "l-p69"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "mediation"
      }
    },
    {
      "id": "lc-activity",
      "term": "Деятельность",
      "theoryId": "leontiev-theory",
      "definition": "Особенная деятельность выделяется по побуждающему её мотиву.",
      "sourceIds": [
        "l-p56"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "activity"
      }
    },
    {
      "id": "lc-action",
      "term": "Действие",
      "theoryId": "leontiev-theory",
      "definition": "Процесс, подчинённый сознательной цели; может реализовать разные деятельности.",
      "sourceIds": [
        "l-p54"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "action"
      }
    },
    {
      "id": "lc-operation",
      "term": "Операция",
      "theoryId": "leontiev-theory",
      "definition": "Способ выполнения действия, зависящий от условий достижения цели.",
      "sourceIds": [
        "l-p56"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "operation"
      }
    },
    {
      "id": "lc-motive",
      "term": "Мотив",
      "theoryId": "leontiev-theory",
      "definition": "Предмет, в котором опредмечена потребность и который побуждает деятельность.",
      "sourceIds": [
        "l-p99"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "motive"
      }
    },
    {
      "id": "lc-goal",
      "term": "Цель",
      "theoryId": "leontiev-theory",
      "definition": "Осознаваемый результат, которому подчинено действие.",
      "sourceIds": [
        "l-p54"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "goal"
      }
    },
    {
      "id": "lc-conditions",
      "term": "Условия",
      "theoryId": "leontiev-theory",
      "definition": "Предметные обстоятельства достижения цели, определяющие операционный аспект.",
      "sourceIds": [
        "l-p56"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "conditions"
      }
    },
    {
      "id": "lc-external",
      "term": "Внешняя деятельность",
      "theoryId": "leontiev-theory",
      "definition": "Практическая форма деятельности, связанная с внутренней общим строением.",
      "sourceIds": [
        "l-p52"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "external"
      }
    },
    {
      "id": "lc-internal",
      "term": "Внутренняя деятельность",
      "theoryId": "leontiev-theory",
      "definition": "Внутренняя форма деятельности сохраняет двустороннюю связь с внешней.",
      "sourceIds": [
        "l-p52"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "internal"
      }
    },
    {
      "id": "lc-consciousness",
      "term": "Сознание",
      "theoryId": "leontiev-theory",
      "definition": "Индивидуальное сознание формируется в связи с деятельностью и общественными отношениями.",
      "sourceIds": [
        "l-p69"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "consciousness"
      }
    },
    {
      "id": "lc-sensory",
      "term": "Чувственная ткань",
      "theoryId": "leontiev-theory",
      "definition": "Чувственное предъявление предметного мира — одна из образующих сознания.",
      "sourceIds": [
        "l-design"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "sensory"
      }
    },
    {
      "id": "lc-meaning",
      "term": "Значение",
      "theoryId": "leontiev-theory",
      "definition": "Общественно-историческое содержание, функционирующее в индивидуальном сознании.",
      "sourceIds": [
        "l-p78"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "meaning"
      }
    },
    {
      "id": "lc-sense",
      "term": "Личностный смысл",
      "theoryId": "leontiev-theory",
      "definition": "Жизненное значение обстоятельств и действий для субъекта в отношении к мотиву.",
      "sourceIds": [
        "l-p80"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "sense"
      }
    },
    {
      "id": "lc-personality",
      "term": "Личность",
      "theoryId": "leontiev-theory",
      "definition": "В основании личности — отношения соподчинённости деятельностей.",
      "sourceIds": [
        "l-p98"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "personality"
      }
    },
    {
      "id": "lc-need",
      "term": "Потребность",
      "theoryId": "leontiev-theory",
      "definition": "Получает предметное содержание в ходе деятельности.",
      "sourceIds": [
        "l-p99"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "need"
      }
    },
    {
      "id": "lc-hierarchy",
      "term": "Иерархия мотивов",
      "theoryId": "leontiev-theory",
      "definition": "Соподчинение деятельностей обнаруживает отношения мотивов.",
      "sourceIds": [
        "l-p98"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "hierarchy"
      }
    },
    {
      "id": "lc-emotion",
      "term": "Эмоция",
      "theoryId": "leontiev-theory",
      "definition": "Внутренний сигнал отношения мотива к ходу и возможности реализации деятельности.",
      "sourceIds": [
        "l-p103"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "emotion"
      }
    },
    {
      "id": "lc-outcome",
      "term": "Результат действия",
      "theoryId": "leontiev-theory",
      "definition": "Успех отдельного действия не определяет однозначно эмоциональное переживание.",
      "sourceIds": [
        "l-p103"
      ],
      "atlasBinding": {
        "atlas": "leontiev",
        "conceptId": "outcome"
      }
    }
  ],
